<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>LunaImport</RootNamespace>
    <AssemblyName>LunaImport</AssemblyName>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 記録の書式はプラグイン側の定義をそのまま使う。二重定義にすると必ずずれる -->
    <Compile Include="..\..\src\PlaySession.cs" Link="Shared\PlaySession.cs" />
    <Compile Include="..\..\src\SessionLog.cs" Link="Shared\SessionLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LunaImport.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
