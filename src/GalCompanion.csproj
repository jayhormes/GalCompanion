<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>GalCompanion</RootNamespace>
    <AssemblyName>GalCompanion</AssemblyName>
    <Version>0.2.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Playnite 執行時會提供 SDK 組件，不能打包進 pext -->
    <PackageReference Include="PlayniteSDK" Version="6.16.0" ExcludeAssets="runtime" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <None Update="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>GalCompanion.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
